// Prisma schema for MeetFlow video conferencing application
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  HOST
  CO_HOST
  PARTICIPANT
}

model User {
  id               String               @id @default(cuid())
  name             String
  email            String               @unique
  passwordHash     String
  avatar           String?
  emailVerified    Boolean              @default(false)
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  hostedMeetings   Meeting[]            @relation("HostedMeetings")
  participations   MeetingParticipant[]
  scheduledMeetings ScheduledMeeting[]
  messages         MeetingMessage[]

  @@index([email])
}

model Meeting {
  id           String               @id
  title        String
  hostId       String
  host         User                 @relation("HostedMeetings", fields: [hostId], references: [id], onDelete: Cascade)
  password     String?
  isLocked     Boolean              @default(false)
  waitingRoom  Boolean              @default(false)
  isActive     Boolean              @default(true)
  startTime    DateTime             @default(now())
  endTime      DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  settings     MeetingSettings?
  participants MeetingParticipant[]
  messages     MeetingMessage[]

  @@index([hostId])
  @@index([isActive])
}

model MeetingParticipant {
  id         String    @id @default(cuid())
  meetingId  String
  meeting    Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestName  String?
  role       Role      @default(PARTICIPANT)
  isApproved Boolean   @default(true)
  joinedAt   DateTime  @default(now())
  leftAt     DateTime?

  @@index([meetingId])
  @@index([userId])
}

model ScheduledMeeting {
  id          String   @id @default(cuid())
  title       String
  hostId      String
  host        User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  date        DateTime
  startTime   String
  duration    Int      @default(30) // Duration in minutes
  timeZone    String   @default("UTC")
  password    String?
  waitingRoom Boolean  @default(false)
  meetingId   String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([hostId])
  @@index([date])
}

model MeetingMessage {
  id         String   @id @default(cuid())
  meetingId  String
  meeting    Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  senderId   String?
  sender     User?    @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderName String
  content    String
  isSystem   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([meetingId])
  @@index([createdAt])
}

model MeetingSettings {
  id               String  @id @default(cuid())
  meetingId        String  @unique
  meeting          Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  allowChat        Boolean @default(true)
  allowScreenShare Boolean @default(true)
  muteOnEntry      Boolean @default(false)
  allowReactions   Boolean @default(true)
}
